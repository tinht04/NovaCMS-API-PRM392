<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn> <!-- Tắt cảnh báo thiếu comment -->
  </PropertyGroup>

  <ItemGroup>
	  <PackageReference Include="Autofac" Version="8.3.0" />
	  <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NovaCMS.Application\NovaCMS.Application.csproj" />
    <ProjectReference Include="..\NovaCMS.Infrastructure\NovaCMS.Infrastructure.csproj" />
  </ItemGroup>

</Project>
